# Copy this file to .env and adjust for your machine; do not commit it.
# Both frontends (8080/8081) call http://localhost:3000
PORT=3000
HOST=127.0.0.1

# XAMPP MariaDB defaults: root / empty password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ticketing_system
DB_POOL=10

# Replace in production; the default is for local demos only
JWT_SECRET=dev-only-insecure-secret
# 8 hours, aligned with the API contract
JWT_EXPIRES_SECONDS=28800
